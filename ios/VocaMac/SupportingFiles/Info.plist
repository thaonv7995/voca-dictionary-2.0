				<true/>
			</dict>
		</dict>
	</dict>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Look Up in Voca</string>
			</dict>
			<key>NSMessage</key>
			<string>lookUpInVoca</string>
